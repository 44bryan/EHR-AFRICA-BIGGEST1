# =============================================================================
#  EHR Africa — Environment Variables
#  Copy this file to .env and fill in all values before deploying.
#  NEVER commit .env to version control.
# =============================================================================

# ── Django Core ───────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=replace-this-with-a-50-char-random-string-use-python-secrets

# Comma-separated hostnames / IPs — no trailing slash, no protocol
ALLOWED_HOSTS=ehr.myhospital.cm,www.ehr.myhospital.cm

# Full origins that are trusted to POST forms (HTTPS required in production)
CSRF_TRUSTED_ORIGINS=https://ehr.myhospital.cm

# Admin panel URL path — change from the default to prevent automated scans
ADMIN_URL=hospital-admin-panel/

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgres://ehr_user:strongpassword@localhost:5432/ehr_africa

# ── Redis ─────────────────────────────────────────────────────────────────────
# Used for: Celery task queue, Django cache, session storage
# Format: redis://:PASSWORD@HOST:PORT/DB_INDEX
REDIS_URL=redis://:redispassword@localhost:6379/0

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.myhospital.cm
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=noreply@myhospital.cm
EMAIL_HOST_PASSWORD=smtp-password-here

# ── AI / LLM Keys ─────────────────────────────────────────────────────────────
# Claude (used for clinical data extraction via Voice EMR)
ANTHROPIC_API_KEY=sk-ant-...

# Groq (used for deep clinical reasoning — DeepSeek-R1 chain-of-thought)
GROQ_API_KEY=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
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# Which AI engine to use per feature: groq | claude | ollama
AI_ENGINE_REASONING=groq
AI_ENGINE_EXTRACTION=claude
AI_ENGINE_PRODUCTION=ollama

# Ollama (on-premises LLM — used when AI_ENGINE_PRODUCTION=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.3:70b

# Whisper speech-to-text model size: tiny|base|small|medium|large
# base = good balance for CPU servers; large = best accuracy (needs GPU)
WHISPER_MODEL_SIZE=base

# ── Hospital Identity ─────────────────────────────────────────────────────────
HOSPITAL_NAME=EyeCare Specialist Hospital
HOSPITAL_COUNTRY=Cameroon
HOSPITAL_CITY=Yaoundé
HOSPITAL_ADDRESS=123 Vision Street, Yaoundé, Cameroon
HOSPITAL_PHONE=+237-222-000-000
HOSPITAL_EMAIL=info@myhospital.cm
HOSPITAL_WEBSITE=www.myhospital.cm
HOSPITAL_REG_NUMBER=CM-HEALTH-2024-001

# ── File Storage ──────────────────────────────────────────────────────────────
MEDIA_ROOT=media/

# ── SMS / WhatsApp (Twilio) ───────────────────────────────────────────────────
# Get credentials at: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_FROM_NUMBER=+12345678900
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Set False to disable outbound messages (safe default for dev/staging)
SMS_ENABLED=False

# ── DICOM / Imaging Viewer ────────────────────────────────────────────────────
# Base URL of your OHIF Viewer or Orthanc DICOM server
DICOM_VIEWER_BASE_URL=http://192.168.200.10:3000/viewer

# ── Patient Portal ────────────────────────────────────────────────────────────
PATIENT_PORTAL_BASE_URL=https://portal.myhospital.cm

# ── Performance ───────────────────────────────────────────────────────────────
# Number of Celery worker processes (default 4, tune to server CPU count)
CELERY_CONCURRENCY=4

# Set to False if your server is behind a load balancer that handles SSL
SECURE_SSL_REDIRECT=True
